// ═══════════════════════════════════════════════════════════════
// 🔗 MERGED LIST — সব নার্স একসাথে
// ═══════════════════════════════════════════════════════════════
export const STATIC_NURSES: Nurse[] = [
    ...HOSPITAL_AFFILIATED_NURSES,
    ...INDEPENDENT_NURSES,
    ...HOSPITAL_EXCLUSIVE_NURSES,
];

// ═══════════════════════════════════════════════════════════════
// 🗺️ CATEGORY MAP — O(1) lookup
// ═══════════════════════════════════════════════════════════════
export const NURSES_BY_CATEGORY = {
    'Hospital-Affiliated': HOSPITAL_AFFILIATED_NURSES,
    Independent: INDEPENDENT_NURSES,
    'Hospital-Exclusive': HOSPITAL_EXCLUSIVE_NURSES,
} as const;

// ═══════════════════════════════════════════════════════════════
// 🛠️ HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════

/** নির্দিষ্ট category-র সব নার্স return করে */
export function getNursesByCategory(
    category: keyof typeof NURSES_BY_CATEGORY
): Nurse[] {
    return NURSES_BY_CATEGORY[category] ?? [];
}

/** সব unique হাসপাতালের নাম (sorted) */
export function getAllHospitals(): string[] {
    return Array.from(
        new Set(
            STATIC_NURSES.map((n) => n.hospitalName).filter(
                (h): h is string => Boolean(h)
            )
        )
    ).sort();
}

/** সব unique এলাকার নাম (sorted) */
export function getAllAreas(): string[] {
    return Array.from(new Set(STATIC_NURSES.map((n) => n.area))).sort();
}

/** Category-র metadata — UI filter-এর জন্য label + color */
export const CATEGORY_META = [
    { value: 'All', label: 'সকল ধরন' },
    { value: 'Hospital-Affiliated', label: 'হাসপাতাল-সংযুক্ত' },
    { value: 'Independent', label: 'স্বাধীন' },
    { value: 'Hospital-Exclusive', label: 'হাসপাতাল-এক্সক্লুসিভ' },
] as const;